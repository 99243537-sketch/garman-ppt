# 复制为 .env 后填写；与文章生成服务用同一个 MiniMax Key 即可
MINIMAX_API_KEY=
MINIMAX_BASE=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
HOST=127.0.0.1
PORT=8790
# 每个访客每天几次；全站每天几次（防刷、控制费用）
DAILY_LIMIT=5
GLOBAL_DAILY_LIMIT=200
# 同时调用大模型最多几份（其余排队）；排队加进行中最多几份
MAX_CONCURRENT=3
MAX_QUEUE=20
MAX_REPAIRS=2
MAX_DOC_CHARS=30000
MAX_OUTPUT_TOKENS=24000
# 单次调用大模型最长等多久（秒）；分页结果在内存里保留多久（秒）
REQUEST_TIMEOUT=240
STREAM=1
JOB_TTL=600
ALLOWED_ORIGINS=https://www.zhaodun.work,https://zhaodun.work
