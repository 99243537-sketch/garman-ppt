# 复制为 .env 后填写；与文章生成服务用同一个 MiniMax Key 即可
MINIMAX_API_KEY=
MINIMAX_BASE=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
HOST=127.0.0.1
PORT=8790
DAILY_LIMIT=5
MAX_REPAIRS=2
MAX_DOC_CHARS=30000
MAX_OUTPUT_TOKENS=16000
REQUEST_TIMEOUT=180
ALLOWED_ORIGINS=https://www.zhaodun.work,https://zhaodun.work
